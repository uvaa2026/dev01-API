# Copy this file to .env and fill in real values. Never commit .env.

# ---- Database (Azure Postgres) -------------------------------------------
# Azure Postgres Flexible Server connection string. Get this from the Azure
# portal (Connect blade) or `az postgres flexible-server show-connection-string`.
# Format: postgresql://<user>:<password>@<host>:5432/<database>
DATABASE_URL=postgresql://uvaa_app:changeme@your-server.postgres.database.azure.com:5432/uvaa

# Azure Postgres requires SSL. Keep this true except against a local dev
# database that has no SSL configured.
DB_SSL=true

# ---- Server ----------------------------------------------------------------
PORT=4000
NODE_ENV=development

# Comma-separated list of frontend origins allowed to call this API with
# credentials (CORS). Each must match exactly, scheme included, no trailing
# slash. One value is fine locally; in production list every real frontend
# hitting this API, e.g.:
# FRONTEND_ORIGINS=https://test.uvaa.pro,https://my.uvaa.pro
FRONTEND_ORIGINS=http://localhost:5173

# ---- Auth --------------------------------------------------------------
# Long random string — e.g. `openssl rand -hex 32`. Rotating this logs
# everyone out (all existing session cookies stop verifying).
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=12h
JWT_EXPIRES_IN_REMEMBER=30d

# Leave blank for local dev and for as long as the frontend (test.uvaa.pro)
# and this API live on different registrable domains (e.g. the raw
# *.azurewebsites.net URL) — a Domain the browser can't match to the
# API's actual host makes it reject the cookie outright, which is worse
# than leaving this unset. Once the API is reachable on a uvaa.pro
# subdomain (e.g. api.uvaa.pro), set this to the shared parent domain with
# a leading dot — ".uvaa.pro" — so the session cookie becomes first-party
# between test.uvaa.pro and api.uvaa.pro instead of third-party, which is
# what some browsers (Safari, Firefox strict mode, Brave, and an
# increasing share of Chrome) silently block regardless of SameSite. See
# the COOKIE_DOMAIN comment in src/config.js for the full explanation.
COOKIE_DOMAIN=

# ---- Email verification --------------------------------------------------
# The frontend route that handles the verification link (VerifyEmail.jsx).
APP_VERIFY_URL_BASE=http://localhost:5173/verify

# SMTP for sending real email. Leave all SMTP_* blank during local dev —
# the backend falls back to logging the verification link to the console
# instead of sending an email, so registration is fully testable without
# real credentials. Fill these in with your provider (Azure Communication
# Services Email, SendGrid, or plain SMTP) when you're ready to send for real.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="UVAA <no-reply@uvaa.example.com>"
