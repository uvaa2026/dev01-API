# Copy this file to .env and fill in real values. Never commit .env.

# ---- Database (Azure Postgres) -------------------------------------------
# Azure Postgres Flexible Server connection string. Get this from the Azure
# portal (Connect blade) or `az postgres flexible-server show-connection-string`.
# Format: postgresql://<user>:<password>@<host>:5432/<database>
DATABASE_URL=postgresql://uvaa_app:changeme@your-server.postgres.database.azure.com:5432/uvaa

# Azure Postgres requires SSL. Keep this true except against a local dev
# database that has no SSL configured.
DB_SSL=true

# ---- Server ----------------------------------------------------------------
PORT=4000
NODE_ENV=development

# Origin of the React app, for CORS (must match exactly, no trailing slash).
FRONTEND_ORIGIN=http://localhost:5173

# ---- Auth --------------------------------------------------------------
# Long random string — e.g. `openssl rand -hex 32`. Rotating this logs
# everyone out (all existing session cookies stop verifying).
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=12h
JWT_EXPIRES_IN_REMEMBER=30d

# ---- Email verification --------------------------------------------------
# The frontend route that handles the verification link (VerifyEmail.jsx).
APP_VERIFY_URL_BASE=http://localhost:5173/verify

# SMTP for sending real email. Leave all SMTP_* blank during local dev —
# the backend falls back to logging the verification link to the console
# instead of sending an email, so registration is fully testable without
# real credentials. Fill these in with your provider (Azure Communication
# Services Email, SendGrid, or plain SMTP) when you're ready to send for real.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="UVAA <no-reply@uvaa.example.com>"
